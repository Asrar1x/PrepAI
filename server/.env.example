# ============================================================
# PrepAI API — environment configuration
# Copy to .env and adjust. Every key here is read by src/config/env.js
# (or the provider it names); nothing else is required.
# ============================================================

# --- Server & database ---
PORT=7857
APP_ENV=development                 # production refuses to boot with the dev JWT secret
MONGODB_URI=mongodb://127.0.0.1:27017/prepai
CORS_ORIGINS=http://localhost:5174,http://127.0.0.1:5174

# --- Auth (15-minute access tokens, rotating refresh tokens) ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=30

# --- Generation provider (ollama | anthropic | gemini | openai) ---
AI_PROVIDER=ollama
AI_MODEL=qwen2.5-coder:7b           # live interview dialogue (keep it fast)
EVALUATION_MODEL=qwen3:8b           # background answer grading, reference packs, report prose
VISION_MODEL=qwen2.5vl:3b           # camera tutor: webcam frames analysed after the interview
AI_FALLBACK_PROVIDER=               # optional second provider if the primary is down
AI_TIMEOUT_MS=90000
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Hosted providers (only needed when selected above)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=                    # any OpenAI-compatible endpoint

# --- Embeddings (semantic similarity signal) ---
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text

# --- Laya decision engine (services/laya-engine) ---
LAYA_ENABLED=true
LAYA_MODEL=convaiinnovations/laya
LAYA_SERVICE_URL=http://127.0.0.1:7860
LAYA_TIMEOUT_MS=30000               # background evaluation budget (CPU inference p95 is about 17 s)
LAYA_TURN_TIMEOUT_MS=7000           # live interview turn budget (signal recorded as unavailable on timeout)

# --- Voice ---
STT_PROVIDER=browser                # Web Speech API in the browser
STT_MODEL=
TTS_PROVIDER=edge                   # Microsoft Edge neural voices via msedge-tts
TTS_MODEL=
