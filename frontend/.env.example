# PrepAI Frontend Environment Configuration
# Production Base API URL (e.g. http://localhost:7857/api/v1 or production domain)
VITE_API_URL=http://localhost:7857/api/v1

# Public LiveKit WebRTC Server URL
VITE_LIVEKIT_URL=

# Sentry Monitoring DSN (Optional)
VITE_SENTRY_DSN=

# Mock Mode (set to 'true' to run fully offline without backend)
VITE_USE_MOCK_API=false
